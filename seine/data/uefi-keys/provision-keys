#!/bin/sh
# Written by seine from seine/data/uefi-keys/provision-keys.
# Enrolls whichever signature lists were bundled, in ascending
# authority order -- PK last, since that locks firmware into User
# Mode and ends Setup Mode enrollment.

set -e

CERTDIR=/usr/share/[[ name ]]

enroll() {
	var="$1"
	file="$CERTDIR/$2.esl"
	[ -f "$file" ] || return 0
	efi-updatevar -e -f "$file" "$var"
}

enroll dbx dbx
enroll db db
enroll KEK kek

# PK, unlike KEK/db/dbx: SetVariable() for PK always needs a signed
# EFI_VARIABLE_AUTHENTICATION_2, Setup Mode included, so this is
# already an authenticated update -- no '-e' -- built by resigning
# 'pk.auth' with the vault after the package builds.
if [ -f "$CERTDIR/pk.auth" ]; then
	efi-updatevar -f "$CERTDIR/pk.auth" PK
fi
[% if reboot %]
systemctl --no-block reboot
[% endif %]
